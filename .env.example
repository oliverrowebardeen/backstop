TELEM_API_KEY=
TAVILY_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHECKER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5
SO_CACHE=readwrite
TELEM_MAX_CONCURRENCY=16
TELEM_BUDGET_USD=25
LLM_MAX_CONCURRENCY=8
LLM_BUDGET_USD=25
# OpenAI/custom models need explicit model names above and verified prices below.
# Prices are USD per million tokens. Entries merge with the defaults below.
LLM_PRICE_USD_JSON='{"claude-haiku-5-5":{"input":0.10,"output":0.50,"cache_read_factor":0.1,"cache_write_factor":1.25,"cache_write_1h_factor":2.0,"long_context_threshold":100000,"long_input":0.50,"long_output":2.50},"claude-sonnet-5-5":{"input":2.0,"output":10.0,"cache_read_factor":0.05,"cache_write_factor":1.25,"cache_write_1h_factor":2.0}}'
# Tavily Extract PAYG rate; change if your account has a different credit price.
TAVILY_CREDIT_USD=0.008

# Retrieval defaults. Update prices when changing providers or the search tier.
ENGINES=tavily,exa,brave,perplexity,parallel,ceramic
FIRST_ENGINE=tavily
SUBSTITUTES=seltz,you,linkup
FALLBACK_ORDER=exa,perplexity,brave,parallel,ceramic
PRICE_USD_JSON='{"tavily":0.005,"brave":0.005,"you":0.005,"parallel":0.001,"ceramic":0.00005,"tinyfish":0.0,"perplexity":0.005,"seltz":0.005,"linkup":0.005,"serpapi":0.006}'
DEFAULT_PRICE_USD=0.005
TELEM_FETCH_PROVIDER=tavily
TELEM_FETCH_PRICE_USD=0.001
# Unset TELEM_ROUTING_ENGINES to reserve the combined ENGINES, SUBSTITUTES and price-map engines.
TELEM_BASE_URL=https://router.telem.ai
TELEM_TIMEOUT_S=60
TELEM_TIER=default
TELEM_NUM_RESULTS=5
RESULT_SNIPPET_CHARS=500
PAGE_TEXT_CHARS=6000
PAGE_CONTENT_FORMAT=text
TAVILY_API_URL=https://api.tavily.com
TAVILY_TIMEOUT_S=30
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_PRICE_USD=0.0016

# Paths default relative to the repository; SO_LOG_DIR defaults under SO_OUT_DIR.
SO_ENV_FILE=.env
SO_CACHE_DIR=cache
SO_OUT_DIR=out
SO_LOG_DIR=out/logs

# Agent control limits and prompt. LOG_DIR in Python aliases SO_LOG_DIR.
AGENT_MAX_SEARCHES=6
AGENT_MAX_PAGE_READS=12
AGENT_MAX_TURNS=24
AGENT_PROMPT_PATH=so/prompts/agent.md
SO_ENABLE_SECOND_OPINION=true
MAX_RESCUES=2
FRESHNESS_DAYS=90
RESCUE_TABLE_PATH=out/rescue_table.json

# Model transport and token limits.
LLM_TIMEOUT_S=90
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_MESSAGES_URL defaults to ANTHROPIC_BASE_URL + /v1/messages.
# OPENAI_CHAT_URL defaults to OPENAI_BASE_URL + /chat/completions.
ANTHROPIC_API_VERSION=2023-06-01
# Agent and judge caps. The checker's cap is CHECKER_MAX_TOKENS; a "checker" entry here would override it.
LLM_MAX_TOKENS_JSON='{"agent":2048,"judge":1024}'
LLM_TOKEN_RESERVE_OVERHEAD=1024
API_MAX_RETRIES=3
API_RETRY_BACKOFF_S=0.5

# Checker
# A HIT below this confidence is not trusted; the page it cites is read instead (0 to 1).
CHECKER_HIT_MIN_CONFIDENCE=0.6
# Thinking mode: disabled, adaptive, or empty for the model default. Hidden thinking
# counts against CHECKER_MAX_TOKENS, so keep it disabled unless you raise the cap.
CHECKER_THINKING=disabled
# Output cap per checker call; a verdict is about 100 tokens.
CHECKER_MAX_TOKENS=399

# Server
# Leave these paths unset to inherit the repository and shared output settings.
# SERVER_UI_DIR defaults to <repository>/ui.
# SERVER_DEMO_DIR defaults to <repository>/demo.
# SERVER_LOG_DIR defaults to SO_LOG_DIR.
# SERVER_RESULTS_PATH defaults to SO_OUT_DIR/results.json.
# SERVER_FRONTIER_PATH defaults to SO_OUT_DIR/frontier.json.
# Fixtures are disabled when empty. For local acceptance use tests/o4/fixtures.
SERVER_FIXTURE_DIR=
SERVER_MAX_ACTIVE_RUNS=8
SERVER_MAX_QUESTION_CHARS=2000
SERVER_START_TIMEOUT_SECONDS=10
SERVER_RUN_TIMEOUT_SECONDS=180
SERVER_POLL_SECONDS=0.05
SERVER_KEEPALIVE_SECONDS=10
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Verified search limits per call (overridable per call in BackstopTelem and /v1/search).
SEARCH_MAX_COST_USD=0.03
SEARCH_TIMEOUT_S=12
CHECKER_TIMEOUT_S=4

# Hosted API (/v1/search). Comma-separated bearer keys; usage is metered in BACKSTOP_USAGE_DB.
BACKSTOP_API_KEYS=
BACKSTOP_USAGE_DB=out/usage.db
BACKSTOP_RATE_LIMIT_PER_MIN=60
